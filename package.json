{
  "name": "pixel-city-crime-3d",
  "version": "1.0.0",
  "description": "Pixel City Crime 3D - First-person open-world game built with Three.js, Cannon-es, and TypeScript",
  "license": "MIT",
  "author": "Yuchenhui",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yuchenhui/PIXEL-CITY-CRIME-3D.git"
  },
  "keywords": [
    "threejs",
    "game",
    "first-person",
    "open-world",
    "procedural-generation",
    "typescript",
    "vite"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "compile-story": "node tools/compile-story.cjs"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "inkjs": "^2.4.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/three": "^0.160.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0"
  }
}
