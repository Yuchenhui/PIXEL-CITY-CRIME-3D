=","/ev",{"->":".^.s0","c":true},"ev","du",1,"==","/ev",{"->":".^.s1","c":true},"ev","du",2,"==","/ev",{"->":".^.s2","c":true},"nop",{"s0":["pop","\n","^有人在阳台上晾衣服，水滴到我头上。","\n",{"->":".^.^.23"},null],"s1":["pop","\n","^一个老太太在路边烧纸钱，嘴里念念有词。","\n",{"->":".^.^.23"},null],"s2":["pop","\n","^几个小孩在巷子里追逐打闹，差点撞到我。","\n",{"->":".^.^.23"},null],"#f":5}],"\n","#","^speaker: 阿城","/#","^（这里的人看都不看我一眼，好像已经习惯了陌生人。）","\n",{"->":"meet_little_fish"},null],"alley_encounter":["#","^speaker: 阿城","/#","^（我躲在一条死胡同里，喘着粗气。）","\n","#","^speaker: 阿城","/#","^（巷子尽头坐着一个瘦小的少年，嘴里叼着根草，好奇地打量着我。）","\n",{"->":"meet_little_fish"},null],"meet_little_fish":[["#","^speaker: 小鱼","/#","^喂，你新嚟㗎？俾人追紧？","\n","#","^speaker: 阿城","/#","^你是谁？","\n","#","^speaker: 小鱼","/#","^我叫小鱼。喺城寨入面，冇人唔识我。","\n","#","^speaker: 小鱼","/#","^你睇你个样，一定系大陆偷渡过嚟嘅。","\n","#","^speaker: 阿城","/#","^你怎么知道？","\n","#","^speaker: 小鱼","/#","^（咧嘴一笑）因为我都系。五岁嗰年跟阿妈过嚟嘅，不过阿妈已经唔喺度啦。","\n","ev",true,"/ev",{"VAR=":"met_little_fish","re":true},"ev","str","^met_little_fish","/str",true,{"x()":"setFlag","exArgs":2},"pop","/ev","\n","#","^speaker: 小鱼","/#","^你想喺城寨落脚？我可以带你。不过我好肚饿……","\n","ev","str","^把仅剩的干粮分给他","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^答应找到住处后请他吃饭","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^问他要什么条件","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["^ ",{"->":".^.^.^.share_food"},"\n",{"#f":5}],"c-1":["^ ",{"->":".^.^.^.promise_food"},"\n",{"#f":5}],"c-2":["^ ",{"->":".^.^.^.ask_condition"},"\n",{"#f":5}]}],{"share_food":["#","^speaker: 阿城","/#","^（我把背包里最后一个馒头递给他。）","\n","#","^speaker: 小鱼","/#","^（眼睛一亮，三口两口就吞了下去）好人！你系好人嚟嘅！","\n","ev",-50,{"x()":"giveMoney","exArgs":1},"pop","/ev","\n","ev","str","^shared_food_with_fish","/str",true,{"x()":"setFlag","exArgs":2},"pop","/ev","\n",{"->":"fish_guides_you"},null],"promise_food":["#","^speaker: 阿城","/#","^等我找到地方住，一定请你吃顿好的。","\n","#","^speaker: 小鱼","/#","^（半信半疑地看着我）你有冇钱啊？","\n","#","^speaker: 阿城","/#","^……不多，但够请你吃碗面。","\n","#","^speaker: 小鱼","/#","^得啦，信你一次。","\n",{"->":"fish_guides_you"},null],"ask_condition":["#","^speaker: 阿城","/#","^你要什么条件？","\n","#","^speaker: 小鱼","/#","^（伸出五根手指）五十蚊。带你揾到住嘅地方，五十蚊。","\n","#","^speaker: 阿城","/#","^（我犹豫了一下，点了点头。）","\n","ev",-50,{"x()":"giveMoney","exArgs":1},"pop","/ev","\n","#","^speaker: 小鱼","/#","^爽快！跟住我行。","\n",{"->":"fish_guides_you"},null]}],"fish_guides_you":[["#","^speaker: 小鱼","/#","^城寨入面有规矩嘅。东边系辉哥嘅地盘，赌档同档口都喺嗰边。","\n","#","^speaker: 小鱼","/#","^西边系邓威嘅人，佢哋做嘅嘢……你唔想知道。","\n","#","^speaker: 阿城","/#","^那中间呢？","\n","#","^speaker: 小鱼","/#","^中间？中间系三不管地带。华哥嘅茶餐厅就喺嗰度。","\n","ev","str","^问关于辉哥的事","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^问关于邓威的事","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^问关于华哥的事","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["^ ",{"->":".^.^.^.ask_about_vinny"},"\n",{"#f":5}],"c-1":["^ ",{"->":".^.^.^.ask_about_tang"},"\n",{"#f":5}],"c-2":["^ ",{"->":".^.^.^.ask_about_hua"},"\n",{"#f":5}]}],{"ask_about_vinny":["#","^speaker: 阿城","/#","^辉哥是什么人？","\n","#","^speaker: 小鱼","/#","^陈文辉。三合会三合会嘅大佬。佢控制住成个城寨嘅赌档同毒品生意。","\n","#","^speaker: 小鱼","/#","^佢手下有个叫铁手嘅，好打得，你千祈唔好得罪佢哋。","\n","ev",true,"/ev",{"VAR=":"knows_about_vinny","re":true},"ev","str","^knows_about_vinny","/str",true,{"x()":"setFlag","exArgs":2},"pop","/ev","\n",{"->":"fish_continues"},null],"ask_about_tang":["#","^speaker: 阿城","/#","^邓威又是什么人？","\n","#","^speaker: 小鱼","/#","^从金三角过嚟嘅毒枭。同辉哥系死对头。","\n","#","^speaker: 小鱼","/#","^最近两边嘅人经常冲突，城寨入面唔太平。","\n","ev","str","^knows_about_tang","/str",true,{"x()":"setFlag","exArgs":2},"pop","/ev","\n",{"->":"fish_continues"},null],"ask_about_hua":["#","^speaker: 阿城","/#","^华哥是谁？","\n","#","^speaker: 小鱼","/#","^华哥啊，以前系三合会嘅二把手，后来金盆洗手，开咗间茶餐厅。","\n","#","^speaker: 小鱼","/#","^佢系好人嚟嘅。城寨入面有咩事，佢都肯帮忙。","\n","ev","str","^knows_about_hua","/str",true,{"x()":"setFlag","exArgs":2},"pop","/ev","\n",{"->":"fish_continues"},null]}],"fish_continues":["#","^speaker: 小鱼","/#","^好啦，我带你去一个安全嘅地方。","\n","#","^speaker: 小鱼","/#","^不过你要小心，前面嗰段路经常有铁手嘅人巡逻。","\n",["ev","visit",3,"seq","/ev","ev","du",0,"==","/ev",{"->":".^.s0","c":true